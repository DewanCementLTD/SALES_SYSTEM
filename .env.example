# DCL Sales & Dispatch — environment variables.
# Copy to `.env` in the repository root and fill in. Never commit `.env`.

NODE_ENV=development
# All business dates and times are Asia/Karachi.
TZ=Asia/Karachi
LOG_LEVEL=info

# ---- Oracle (application connection) ----
DATABASE_USER=sales_new
DATABASE_PASSWORD=
# host:port/service, e.g. dbhost:1521/xe
DATABASE_CONNECT_STRING=
# thick = Oracle Instant Client (required for 11g); thin = pure JS (19c+ only)
ORACLE_CLIENT_MODE=thick
# Folder with oci.dll (Windows) / libclntsh.so (Linux); Thick mode only
ORACLE_LIB_DIR=C:/oracle/instantclient
DB_POOL_MIN=4
DB_POOL_MAX=30
# Thick mode: every DB call in flight holds a libuv thread. Must be >= DB_POOL_MAX + 4,
# set before Node starts (Windows reads it at start-up), otherwise lock waits can deadlock the pool.
UV_THREADPOOL_SIZE=64

# ---- Oracle (integration tests; every test rolls back) ----
TEST_DB_USER=
TEST_DB_PASSWORD=
TEST_DB_CONNECT_STRING=

# ---- Redis (BullMQ queues). Memurai on Windows, Redis 7 on Linux ----
REDIS_URL=redis://127.0.0.1:6379

# ---- Secrets (generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ----
# Signs access tokens (HS256)
JWT_SECRET=
# Signs DO/permit/gate-pass QR payloads (BR-QR-01)
QR_SECRET=
# 32 bytes, base64. AES-256-GCM key for stored SMTP/FBR/TOTP/device secrets
APP_ENC_KEY=

# ---- HTTP ----
API_PORT=4000
API_HOST=0.0.0.0
# URL the web app (server side) uses to reach the API
API_URL=http://localhost:4000
# Browser origin allowed by CORS and used for cookies
WEB_ORIGIN=http://localhost:3200
# Base for public share links /s/{token}
PUBLIC_BASE_URL=http://localhost:3200
# Set to true behind TLS (secure cookies)
COOKIE_SECURE=false

# ---- Notifications ----
# console | http-generic
SMS_DRIVER=console
# http-generic only, e.g. https://sms.example/send?to={to}&text={text}
SMS_URL_TEMPLATE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- PDF (worker) ----
# Optional: path to Chromium; empty = Playwright's bundled browser
PDF_CHROMIUM_PATH=
STORAGE_DIR=./storage

# ---- FBR Digital Invoicing (per branch; P3) ----
FBR_ENV_1=sandbox
FBR_TOKEN_1=
FBR_ENV_2=sandbox
FBR_TOKEN_2=
