  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true
