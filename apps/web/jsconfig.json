{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "jsx": "react-jsx",
    "checkJs": true,
    "strict": false,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2023"
  },
  "include": ["src", "e2e", "*.mjs", "*.js"],
  "exclude": ["node_modules", ".next"]
}
