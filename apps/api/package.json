{
  "name": "@dcl/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.js",
    "start": "node --env-file-if-exists=../../.env src/server.js",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "db:migrate": "node --env-file-if-exists=../../.env src/cli/migrate.js",
    "db:seed": "node --env-file-if-exists=../../.env src/cli/seed.js",
    "openapi": "node --env-file-if-exists=../../.env src/cli/openapi.js"
  },
  "dependencies": {
    "@dcl/shared": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.9",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.5",
    "@fastify/swagger-ui": "6.1.4",
    "@node-rs/argon2": "2.2.2",
    "@prometheus-io/client": "0.16.1",
    "bullmq": "6.7.8",
    "fastify": "5.12.8",
    "fastify-plugin": "5.1.0",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.18",
    "knex": "3.3.0",
    "oracledb": "26.0.0",
    "otplib": "13.6.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "13.2.0",
    "vitest": "5.1.1"
  }
}
